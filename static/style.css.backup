
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
    --cream: #F6F3EA;
    --green: #1F5C3A;
    --dark-green: #13261B;
    --terracotta: #9A3412;
    --text: #2B3A31;
    --pale-green: #DCE8DD;
    --border: #E3DDCB;
    --white: #FFFFFF;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--cream);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

.wrapper {
    width: min(1160px, calc(100% - 48px));
    margin: 0 auto;
}

header {
    background: var(--cream);
    border-bottom: 1px solid var(--border);
}

.navbar {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.logo {
    color: var(--dark-green);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 25px;
    font-weight: 700;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 14px;
    font-weight: 600;
}

.nav-links a:hover {
    color: var(--green);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.btn {
    display: inline-block;
    padding: 14px 26px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s ease;
    border: 1px solid transparent;
}

.btn-primary {
    background: var(--green);
    color: var(--white);
}

.btn-primary:hover {
    background: var(--dark-green);
}

.btn-outline {
    border-color: var(--border);
    color: var(--dark-green);
}

.btn-outline:hover {
    border-color: var(--green);
    color: var(--green);
}

.hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 70px;
    padding-top: 105px;
    padding-bottom: 110px;
}

.section-label {
    color: var(--terracotta);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 18px;
}

.hero h1 {
    color: var(--dark-green);
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(42px, 5vw, 66px);
    line-height: 1.08;
    letter-spacing: -2.5px;
    margin-bottom: 24px;
}

.hero-description {
    max-width: 550px;
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
}

.live-match {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 16px 45px rgba(19, 38, 27, 0.07);
}

.match-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
}

.match-top span {
    color: var(--green);
    background: var(--pale-green);
    padding: 7px 12px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
}

.live-match h2 {
    color: var(--dark-green);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 27px;
    margin-bottom: 24px;
}

.match-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.match-detail {
    background: var(--cream);
    border-radius: 12px;
    padding: 16px;
}

.match-detail small {
    display: block;
    color: #758078;
    font-size: 12px;
    margin-bottom: 6px;
}

.match-detail strong {
    color: var(--dark-green);
    font-size: 17px;
}

.map-placeholder {
    margin-top: 22px;
    min-height: 145px;
    border-radius: 13px;
    background: var(--pale-green);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--green);
    font-weight: 600;
}

.impact {
    background: var(--green);
    color: var(--white);
    padding: 36px 0;
}

.impact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
}

.impact-item strong {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 36px;
    line-height: 1.2;
}

.impact-item span {
    display: block;
    margin-top: 8px;
    font-size: 14px;
    opacity: 0.9;
}

.section {
    padding: 100px 0;
}

.section-heading {
    color: var(--dark-green);
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(34px, 4vw, 46px);
    line-height: 1.15;
    letter-spacing: -1.5px;
    margin-bottom: 45px;
}

.grid-four {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
}

.card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 25px;
    min-height: 205px;
}

.card-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--pale-green);
    color: var(--green);
    font-weight: 700;
    margin-bottom: 25px;
}

.card h3 {
    color: var(--dark-green);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 20px;
    margin-bottom: 12px;
}

.card p {
    color: #647168;
    font-size: 14px;
    line-height: 1.8;
}

.matching-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
}

.matching-intro {
    color: #647168;
    font-size: 16px;
    line-height: 1.8;
}

.signal-list {
    display: grid;
    gap: 0;
}

.signal {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
}

.signal strong {
    color: var(--dark-green);
}

.signal span {
    color: #647168;
    font-size: 14px;
    text-align: right;
}

.cta-section {
    padding: 30px 0 100px;
}

.cta-box {
    background: var(--dark-green);
    color: var(--white);
    padding: 65px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.cta-box h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(32px, 4vw, 44px);
    line-height: 1.15;
    margin-bottom: 14px;
}

.cta-box p {
    color: #DCE8DD;
}

.cta-box .btn {
    background: var(--cream);
    color: var(--dark-green);
    white-space: nowrap;
}

footer {
    padding: 35px 0;
    border-top: 1px solid var(--border);
}

.footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-size: 13px;
    color: #647168;
}

.footer-logo {
    font-family: 'Space Grotesk', sans-serif;
    color: var(--dark-green);
    font-size: 21px;
    font-weight: 700;
}

@media (max-width: 900px) {
    .nav-links {
        gap: 14px;
    }

    .hero {
        gap: 35px;
    }

    .grid-four {
        grid-template-columns: repeat(2, 1fr);
    }

    .matching-section {
        gap: 35px;
    }
}

@media (max-width: 650px) {
    .wrapper {
        width: min(100% - 32px, 1160px);
    }

    .navbar {
        padding: 18px 0;
        flex-wrap: wrap;
    }

    .nav-links {
        order: 3;
        width: 100%;
        overflow-x: auto;
        padding: 8px 0;
    }

    .nav-actions {
        gap: 7px;
    }

    .nav-actions .btn {
        padding: 10px 13px;
    }

    .hero {
        grid-template-columns: 1fr;
        padding-top: 65px;
        padding-bottom: 65px;
    }

    .hero h1 {
        font-size: 43px;
    }

    .impact-grid {
        grid-template-columns: repeat(2, 1fr);
        row-gap: 30px;
    }

    .section {
        padding: 70px 0;
    }

    .grid-four {
        grid-template-columns: 1fr;
    }

    .matching-section {
        grid-template-columns: 1fr;
    }

    .cta-box {
        padding: 35px 25px;
        flex-direction: column;
        align-items: flex-start;
    }

    .footer-content {
        flex-direction: column;
        align-items: flex-start;
    }
}
